{
  "name": "mdtranslate-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace backend run start\" \"npm --workspace frontend run dev\"",
    "frontend": "npm --workspace frontend run dev",
    "backend": "npm --workspace backend run start",
    "build": "npm --workspace frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
